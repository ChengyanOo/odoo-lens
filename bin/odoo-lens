#!/usr/bin/env bash
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(dirname "$here")"
old_python_warning="odoo-lens: warning: %s is older than Python 3.12; Odoo saas-19.1+ sources need 3.12 to be indexed\n"
# ODOO_LENS_PYTHON is used exclusively (must be >= 3.10): no probing, no fallback
if [ -n "${ODOO_LENS_PYTHON:-}" ]; then
  py="$ODOO_LENS_PYTHON"
  if ! command -v "$py" >/dev/null 2>&1; then
    echo "odoo-lens: ODOO_LENS_PYTHON=$py not found" >&2
    exit 1
  fi
  if ! "$py" -c "import sys; sys.exit(sys.version_info < (3, 10))" 2>/dev/null; then
    echo "odoo-lens: ODOO_LENS_PYTHON=$py is not Python >= 3.10" >&2
    exit 1
  fi
  "$py" -c "import sys; sys.exit(sys.version_info < (3, 12))" 2>/dev/null || printf "$old_python_warning" "$py" >&2
  # -I: isolated mode, so a workspace's odoo/ package or a stray json.py cannot shadow our imports
  exec "$py" -I "$root/odoo_lens_main.py" "$@"
fi
# prefer 3.12+ (saas-19.1+ sources need its parser); probe known paths (GUI-started Claude: minimal PATH)
candidates=()
for v in 3.12 3.13 3.14 3.15; do
  candidates+=("python$v" "/opt/homebrew/bin/python$v" "/usr/local/bin/python$v" "$HOME/.local/bin/python$v" "$HOME/.pyenv/shims/python$v" "/usr/bin/python$v")
done
candidates+=(python3 /opt/homebrew/bin/python3 /usr/local/bin/python3 python3.11 python3.10 /opt/homebrew/bin/python3.11 /opt/homebrew/bin/python3.10 /usr/bin/python3)
min=12
for pass in 1 2; do
  for py in "${candidates[@]}"; do
    command -v "$py" >/dev/null 2>&1 || continue
    if "$py" -c "import sys; sys.exit(sys.version_info < (3, $min))" 2>/dev/null; then
      [ "$min" = 12 ] || printf "$old_python_warning" "$py" >&2
      exec "$py" -I "$root/odoo_lens_main.py" "$@"
    fi
  done
  min=10
done
echo "odoo-lens: no Python >= 3.10 found (set ODOO_LENS_PYTHON)" >&2
exit 1
